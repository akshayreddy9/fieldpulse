# Copy to .env (or set in your hosting) and fill in. Never commit the real .env.
PORT=8787
DB_FILE=./data/msr-pulse.db

# Long random string. If unset, one is generated and stored in the database.
JWT_SECRET=

# Login codes: DEMO_MODE=1 uses the fixed code 482913 and shows it on screen. Use 0 in production.
DEMO_MODE=1
# SMS: console (prints codes to the server log) or webhook (POSTs {to, message} to your SMS gateway)
SMS_PROVIDER=console
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# AI (Claude). Leave empty to use the built-in report writer and question parser.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
